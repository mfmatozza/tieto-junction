ANTHROPIC_API_KEY=
GITHUB_TOKEN=

# Aiven PostgreSQL (must)
AIVEN_PG_URL=postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require

# Aiven Kafka (must) - SASL/SSL
AIVEN_KAFKA_BOOTSTRAP=HOST:PORT
AIVEN_KAFKA_USER=avnadmin
AIVEN_KAFKA_PASSWORD=
AIVEN_KAFKA_CA_PEM=./ca.pem

# Aiven Valkey (nice to have)
AIVEN_VALKEY_URL=rediss://default:PASSWORD@HOST:PORT

# Aiven OpenSearch (skipped unless time is left)
AIVEN_OPENSEARCH_URL=
AIVEN_OPENSEARCH_USER=
AIVEN_OPENSEARCH_PASSWORD=

# GitHub OAuth app (callback: http://localhost:8000/auth/github/callback). Empty = demo login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
